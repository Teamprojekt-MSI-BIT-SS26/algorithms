# Configuration for the local Django API (python manage.py runserver).
# Copy this file to env/.env and adjust the values. env/.env is not committed.
# Variables that are already set in the shell take precedence over this file.

# Bcrypt hashes of the API keys that may call the API, hex encoded, separated by spaces.
# Generate one with: python -m utils.api_auth <key>
# Clients (e.g. the teamable-backend) send the plain key in the X-Api-Key header.
API_AUTH_ALLOWED_KEYS=

# Optional. Without a value, a fixed development key is used.
DJANGO_SECRET_KEY=

# Database. Leave DB_ENGINE empty to use the local SQLite file db.sqlite3 in the repository root.
# For PostgreSQL, set DB_ENGINE=django.db.backends.postgresql and fill in the values below.
DB_ENGINE=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
